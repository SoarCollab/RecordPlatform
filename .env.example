# ==============================================================================
# RecordPlatform 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件不应提交到版本控制系统
#
# 重要：数据库、Redis、邮件、RabbitMQ 等敏感配置已迁移至 Nacos 配置中心
#
# ==============================================================================

# ==============================================================================
# Nacos 配置中心
# ==============================================================================
NACOS_HOST=localhost
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_USERNAME=replace_with_nacos_username
NACOS_PASSWORD=replace_with_strong_nacos_password

# ==============================================================================
# 基础设施服务凭据 (docker-compose.infra.yml)
# ==============================================================================
# 安全默认值：Compose 默认只绑定 127.0.0.1。生产/服务器部署前必须填写强随机凭据。
INFRA_BIND_ADDRESS=127.0.0.1
OBSERVABILITY_BIND_ADDRESS=127.0.0.1
DB_PORT=3306
DB_PASSWORD=replace_with_strong_database_password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=replace_with_rabbitmq_username
RABBITMQ_PASSWORD=replace_with_strong_rabbitmq_password
NACOS_AUTH_TOKEN=replace_with_base64_32_byte_or_longer_nacos_auth_token
NACOS_AUTH_IDENTITY_KEY=replace_with_nacos_identity_key_name
NACOS_AUTH_IDENTITY_VALUE=replace_with_strong_nacos_identity_secret

# ==============================================================================
# Knife4j API 文档配置 (开发环境)
# ==============================================================================
KNIFE4J_USERNAME=replace_with_knife4j_username
KNIFE4J_PASSWORD=replace_with_strong_knife4j_password

# ==============================================================================
# S3 兼容对象存储
# ==============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=replace_with_minio_access_key
S3_SECRET_KEY=replace_with_strong_minio_secret_key
S3_BUCKET_NAME=forum
MINIO_A_API_PORT=9000
MINIO_A_CONSOLE_PORT=9001
MINIO_B_API_PORT=9010
MINIO_B_CONSOLE_PORT=9011

# ==============================================================================
# 安全配置
# ==============================================================================
# JWT 密钥 (建议使用 32 字符以上的随机字符串)
# 同时用于 ID 加密密钥派生，无需额外配置
JWT_KEY=your_jwt_secret_key_at_least_32_characters
# 文件密钥信封 provider。生产必须显式选择 local 或 vault-transit。
FILE_KEY_ENVELOPE_ACTIVE_PROVIDER=local
FILE_KEY_ENVELOPE_ACTIVE_PROVIDER_CONTRACT_VERSION=1
# local 仅用于开发、历史读取或显式生产部署；生产 key 必须独立于 JWT_KEY 且至少 32 字符。
FILE_KEY_ENVELOPE_LOCAL_KEY_ID=local-file-key-v1
# 切换 local key id 时保留旧 id（逗号分隔），直至对应信封完成轮换。
FILE_KEY_ENVELOPE_LOCAL_HISTORICAL_KEY_IDS=
FILE_KEY_ENVELOPE_MASTER_KEY=
# Vault Transit 使用 derived aes256-gcm96 key；生产地址必须为 HTTPS。
FILE_KEY_ENVELOPE_VAULT_ADDRESS=
FILE_KEY_ENVELOPE_VAULT_TOKEN=
FILE_KEY_ENVELOPE_VAULT_NAMESPACE=
FILE_KEY_ENVELOPE_VAULT_MOUNT=transit
FILE_KEY_ENVELOPE_VAULT_KEY_NAME=
FILE_KEY_ENVELOPE_VAULT_KEY_VERSION=1
FILE_KEY_ENVELOPE_VAULT_ALLOW_HTTP=false
FILE_KEY_ENVELOPE_VAULT_CONNECT_TIMEOUT=2s
FILE_KEY_ENVELOPE_VAULT_REQUEST_TIMEOUT=5s
FILE_KEY_ENVELOPE_VAULT_MAX_REQUEST_BYTES=65536
FILE_KEY_ENVELOPE_VAULT_MAX_RESPONSE_BYTES=65536
# Dedicated Ed25519 proof issuer key. Keep disabled until both PKCS#8/SPKI values are provisioned.
PROOF_SIGNING_ENABLED=false
PROOF_SIGNING_KEY_ID=
PROOF_SIGNING_KEY_VERSION=1
PROOF_SIGNING_KEY_STATUS=DISABLED
PROOF_SIGNING_PRIVATE_KEY_PKCS8=
PROOF_SIGNING_PUBLIC_KEY_SPKI=
PUBLIC_REGISTRATION_TENANT_ID=0
# 公共 proof、匿名公开分享限流与审计共用的可信代理数字 IP/CIDR，逗号分隔；直连或未知拓扑保持为空。
# 禁止 /0、hostname、URL、端口或通配符；代理必须覆盖/清洗调用者提供的转发头。
# Redis key 使用 rate:limit:public:proof-verification:v2:ip: 与 rate:limit:public:share-access:v2:ip: namespace；不要把 tenant 放入共享桶。
RATE_LIMIT_TRUSTED_PROXY_CIDRS=
# 后端调用 FISCO Dubbo provider 的共享令牌，backend 与 fisco 必须保持一致
BLOCKCHAIN_RPC_TOKEN=replace_with_strong_blockchain_rpc_token

# UID 编码器配置 (用于用户 ID 混淆)
# SALT: 建议 8-16 字符随机字符串
# CLIENT_KEY: 建议 16-32 字符随机字符串
RECORD_PLATFORM_UID_SALT=
RECORD_PLATFORM_CLIENT_KEY=

# ==============================================================================
# CORS 配置
# ==============================================================================
# 允许的前端域名，多个用逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================================================
# FISCO BCOS 区块链配置
# ==============================================================================
BLOCKCHAIN_ACTIVE=local-fisco
FISCO_PEER_ADDRESS=127.0.0.1:20200
FISCO_CHAIN_ID=chain0
FISCO_GROUP_ID=group0
FISCO_CERT_PATH=conf
FISCO_PRIVATE_KEY=
# 仅 blockchain.active=bsn-fisco 时必填；禁止依赖隐式 chain ID
BSN_FISCO_CHAIN_ID=
# 仅 BLOCKCHAIN_ACTIVE=bsn-besu 时使用；私钥必须由部署环境注入，禁止提交真实值
BSN_BESU_RPC_URL=
BSN_BESU_CHAIN_ID=
BSN_BESU_PRIVATE_KEY=
BSN_BESU_CONTRACT_STORAGE=
BSN_BESU_CONTRACT_SHARING=
# 必须指向支持原子替换和可靠文件锁的持久目录，且由同 signer 的受支持实例共享
BSN_BESU_NONCE_STATE_DIRECTORY=/var/lib/record-platform/besu-nonce
# 合约地址 (部署后更新)
FISCO_SHARING_CONTRACT=0x6d5de407db930fd7f5a0d9f19be7ec7bc7b36a2a
FISCO_STORAGE_CONTRACT=0xe7d7b002e51431b300ddc00b2c059ccc41ce4660
# 启动前必须由 contract-deploy.sh 或受审查的 BSN 流程写入真实 tx/block/effectiveAt；空值会失败关闭
FISCO_SHARING_DEPLOYMENT_TX=
FISCO_SHARING_DEPLOYMENT_BLOCK=
FISCO_SHARING_DEPLOYMENT_EFFECTIVE_AT=
FISCO_STORAGE_DEPLOYMENT_TX=
FISCO_STORAGE_DEPLOYMENT_BLOCK=
FISCO_STORAGE_DEPLOYMENT_EFFECTIVE_AT=
# 不含凭据的结构化部署回执目录；生产环境应指向持久化、受限访问的外部目录
CONTRACT_DEPLOYMENT_RECEIPT_DIR=log/contract-deployments

# ==============================================================================
# 服务端口配置
# ==============================================================================
# Backend Web API 端口 (生产环境 80，开发环境 8000)
SERVER_PORT=8000

# Dubbo Triple 协议端口
DUBBO_FISCO_PORT=8091
DUBBO_STORAGE_PORT=8092

# Dubbo 服务注册 IP (用于 Docker 环境，避免注册 Docker 网桥 IP)
# 设置为服务器内网 IP，确保 Consumer 能访问 Provider
DUBBO_HOST=127.0.0.1

# Dubbo QoS 管理端口
QOS_BACKEND_PORT=22330
QOS_FISCO_PORT=22331
QOS_STORAGE_PORT=22332

# ==============================================================================
# 日志配置
# ==============================================================================
LOG_LEVEL=INFO
LOG_PATH=/var/log/record-platform

# ==============================================================================
# SkyWalking APM (可选)
# ==============================================================================
SW_AGENT_COLLECTOR_BACKEND_SERVICES=localhost:11800
SW_AGENT_NAME=record-platform
# SQL 参数可能包含文件密钥、分享码或令牌；仅在脱敏测试环境显式改为 true。
SW_JDBC_TRACE_SQL_PARAMETERS=false

# ==============================================================================
# OpenTelemetry Configuration (可选, 启用 --otel 或 Docker 部署时使用)
# ==============================================================================
# OTLP exporter endpoint (gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_PROMETHEUS_PORT=8889
JAEGER_UI_PORT=16686
# Sampling strategy: parentbased_traceidratio, always_on, always_off
OTEL_TRACES_SAMPLER=parentbased_traceidratio
# Sampling ratio (0.0 ~ 1.0, 0.1 = 10% of traces)
OTEL_TRACES_SAMPLER_ARG=0.1

# ==============================================================================
# Spring Profile
# ==============================================================================
# 可选值: local, dev, prod
SPRING_PROFILES_ACTIVE=local

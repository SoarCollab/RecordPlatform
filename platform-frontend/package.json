{
  "name": "platform-frontend",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "types:gen": "openapi-typescript \"${OPENAPI_SOURCE:-http://localhost:8000/record-platform/v3/api-docs}\" -o src/lib/api/types/generated.ts",
    "types:gen:check": "pnpm types:gen && git diff --exit-code -- src/lib/api/types/generated.ts",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest",
    "test:coverage": "svelte-kit sync && vitest run --coverage",
    "test:e2e:download-memory": "playwright test --config=playwright.download-memory.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.14.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.59.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.7",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "3.2.6",
    "bits-ui": "^2.18.1",
    "eslint": "^10.3.0",
    "eslint-plugin-svelte": "^3.17.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "msw": "^2.14.6",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.8",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "7.3.6",
    "vitest": "3.2.6"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "mode-watcher": "^1.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,ts,svelte,html,css,json}": "node scripts/lint-staged-prettier.mjs",
    "*.{js,ts,svelte}": "node scripts/lint-staged-eslint.mjs"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.34.9",
      "onFail": "download"
    }
  }
}

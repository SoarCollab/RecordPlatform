{
  "name": "platform-frontend",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "types:gen": "openapi-typescript \"${OPENAPI_SOURCE:-http://localhost:8000/record-platform/v3/api-docs}\" -o src/lib/api/types/generated.ts",
    "types:gen:check": "pnpm types:gen && git diff --exit-code -- src/lib/api/types/generated.ts",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest",
    "test:coverage": "svelte-kit sync && vitest run --coverage",
    "test:e2e:download-memory": "playwright test --config=playwright.download-memory.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.28.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "3.2.6",
    "bits-ui": "^2.18.1",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "msw": "^2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "7.3.6",
    "vitest": "3.2.6"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "mode-watcher": "^1.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,ts,svelte,html,css,json}": "node scripts/lint-staged-prettier.mjs",
    "*.{js,ts,svelte}": "node scripts/lint-staged-eslint.mjs"
  },
  "packageManager": "pnpm@10.26.1+sha512.664074abc367d2c9324fdc18037097ce0a8f126034160f709928e9e9f95d98714347044e5c3164d65bd5da6c59c6be362b107546292a8eecb7999196e5ce58fa",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.26.1",
      "onFail": "download"
    }
  }
}

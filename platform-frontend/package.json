{
  "name": "platform-frontend",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "types:gen": "openapi-typescript \"${OPENAPI_SOURCE:-http://localhost:8000/record-platform/v3/api-docs}\" -o src/lib/api/types/generated.ts",
    "types:gen:check": "pnpm types:gen && git diff --exit-code -- src/lib/api/types/generated.ts",
    "test": "svelte-kit sync && vitest run",
    "test:watch": "svelte-kit sync && vitest",
    "test:coverage": "svelte-kit sync && vitest run --coverage",
    "test:e2e:download-memory": "playwright test --config=playwright.download-memory.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.70.0",
    "@playwright/test": "1.65.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "bits-ui": "^2.20.6",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.4",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwind-variants": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "mode-watcher": "^1.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "type": "module",
  "lint-staged": {
    "*.{js,ts,svelte,html,css,json}": "node scripts/lint-staged-prettier.mjs",
    "*.{js,ts,svelte}": "node scripts/lint-staged-eslint.mjs"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.34.9",
      "onFail": "download"
    }
  }
}
